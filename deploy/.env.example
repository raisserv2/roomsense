# Copy to .env (never committed) and fill in.

# --- Camera (same values as capture/.env) ---
CAM_URL=http://192.168.0.104:8080/shot.jpg
CAM_USER=roomsense
CAM_PASS=
CAMERA_INTERVAL_SECONDS=5
CAMERA_ENABLED=true

# Ground truth from the capture service while a session records (container name on the shared network)
CAPTURE_STATUS_URL=http://roomsense-capture:8100/status

# --- Model ---
MODEL_URI=models:/roomsense@champion
MODEL_POLL_SECONDS=60
ORT_THREADS=2

# --- Drift monitoring ---
DRIFT_WINDOW=120
DRIFT_MIN_SAMPLES=30
OOD_THRESHOLD=0.5
OOD_MIN_SHARE=0.005
LOW_CONFIDENCE=0.6

# Shared secret the Legion sends when acknowledging a retrain (leave empty to disable)
RETRAIN_TOKEN=

# --- Pipeline console (Pipeline page) ---
PIPELINE_POLL_SECONDS=60
LOG_LEVEL=INFO

# --- Frontend <-> backend link (loose coupling: both are plain settings) ---
# Where the frontend's nginx forwards /api/ :
API_UPSTREAM=http://api:8000
# What the browser calls. "api/" = same origin through nginx. A full URL of the API
# also works (then list the UI's origin in CORS_ORIGINS so the API accepts it).
API_BASE_URL=api/
CORS_ORIGINS=

# --- MLflow: hosts allowed to reach the tracking server ---
MLFLOW_ALLOWED_HOSTS=mlflow,mlflow:5000,localhost,localhost:5000,127.0.0.1:5000,nova.tailb5cb87.ts.net,nova.tailb5cb87.ts.net:5443
# Browser origin of the MLflow web UI. Without it, MLflow 3 blocks the UI's own requests (runs table: INTERNAL_ERROR).
MLFLOW_CORS_ORIGINS=https://nova.tailb5cb87.ts.net:5443

# --- Alerts to Telegram (same bot as Uptime Kuma; leave empty to skip) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=https://nova.tailb5cb87.ts.net:3443/

# --- Tailscale Serve ports of the other tools (links in the UI header) ---
LINK_GRAFANA=3443
LINK_MLFLOW=5443
LINK_PROMETHEUS=6443
LINK_CAPTURE=7443

# --- Host ports (all bound to 127.0.0.1) ---
FRONTEND_PORT=8200
API_PORT=8300
MLFLOW_PORT=5000
GRAFANA_PORT=3300
PROMETHEUS_PORT=9091
ALERTMANAGER_PORT=9093
MLFLOW_SERVE_PORT=5001
