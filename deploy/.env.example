# Copy to .env (never committed) and fill in.

# --- Camera (same values as capture/.env) ---
CAM_URL=http://192.168.0.104:8080/shot.jpg
CAM_USER=roomsense
CAM_PASS=
CAMERA_INTERVAL_SECONDS=5
CAMERA_ENABLED=true

# Ground truth from the capture service while a session records (container name on the shared network)
CAPTURE_STATUS_URL=http://roomsense-capture:8100/status

# --- Model ---
MODEL_URI=models:/roomsense@champion
MODEL_POLL_SECONDS=60
ORT_THREADS=2

# --- Drift monitoring ---
DRIFT_WINDOW=120
DRIFT_MIN_SAMPLES=30
OOD_THRESHOLD=0.5
OOD_MIN_SHARE=0.005
LOW_CONFIDENCE=0.6

# Shared secret the Legion sends when acknowledging a retrain (leave empty to disable)
RETRAIN_TOKEN=

# --- MLflow: hosts allowed to reach the tracking server ---
MLFLOW_ALLOWED_HOSTS=mlflow,mlflow:5000,localhost,localhost:5000,127.0.0.1:5000,nova.tailb5cb87.ts.net,nova.tailb5cb87.ts.net:5443

# --- Alerts to Telegram (same bot as Uptime Kuma; leave empty to skip) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Grafana ---
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_ROOT_URL=https://nova.tailb5cb87.ts.net:3443/

# --- Host ports (all bound to 127.0.0.1) ---
FRONTEND_PORT=8200
API_PORT=8300
MLFLOW_PORT=5000
GRAFANA_PORT=3300
PROMETHEUS_PORT=9091
ALERTMANAGER_PORT=9093
MLFLOW_SERVE_PORT=5001
