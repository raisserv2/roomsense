     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 19,
   "type": "stat",
   "title": "Ray resize throughput",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 14,
    "y": 35,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_pipeline_ray_resize_fps",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "decimals": 0,
     "displayName": "frames / s"
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   },
   "description": "Frames per second of the parallel resize step of the preprocess stage (data engineering throughput)."
  },
  {
   "id": 20,
   "type": "stat",
   "title": "Model versions in the registry",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 19,
    "y": 35,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
