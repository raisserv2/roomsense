    },
    "overrides": []
   },
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showUnfilled": true
   }
  },
  {
   "id": 22,
   "type": "bargauge",
   "title": "Stage throughput (items per second)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 39,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
