     ]
    }
   }
  },
  {
   "id": 21,
   "type": "bargauge",
   "title": "Stage duration (latest execution)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 39,
    "w": 12,
    "h": 7
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_pipeline_stage_seconds",
     "legendFormat": "{{stage}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "blue"
