{
 "uid": "roomsense",
 "title": "RoomSense: live model monitoring",
 "tags": [
  "roomsense",
  "aiops"
 ],
 "timezone": "browser",
 "refresh": "10s",
 "schemaVersion": 39,
 "version": 2,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Room state (camera)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_current_label == 1",
     "legendFormat": "{{label}}",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "textMode": "name",
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "green"
     }
    },
    "overrides": []
   }
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Serving model version",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_model_version",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "textMode": "value",
    "colorMode": "none",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "decimals": 0,
     "unit": "none"
    },
    "overrides": []
   }
  },
  {
   "id": 3,
   "type": "gauge",
   "title": "Drift: frames in unseen lighting",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 10,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_drift_ood_share",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "showThresholdMarkers": true
   },
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "max": 1,
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.25
       },
       {
        "color": "red",
        "value": 0.5
       }
      ]
     },
     "unit": "percentunit"
    },
    "overrides": []
   }
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Live accuracy (capture labels)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 15,
    "y": 0,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_live_accuracy >= 0",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "textMode": "value",
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 0,
     "noValue": "no session",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "red",
        "value": null
       },
       {
        "color": "orange",
        "value": 0.6
       },
       {
        "color": "green",
        "value": 0.8
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Retrain pending",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_retrain_pending",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "options": {
    "textMode": "value",
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "no"
        },
        "1": {
         "text": "YES"
        }
       }
      }
     ],
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Drift over time (alert when unseen share > 50%)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_drift_ood_share",
     "legendFormat": "unseen-lighting share"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "roomsense_drift_psi",
     "legendFormat": "PSI (right axis)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10,
      "thresholdsStyle": {
       "mode": "line+area"
      }
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "transparent",
        "value": null
       },
       {
        "color": "red",
        "value": 0.5
       }
      ]
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "PSI (right axis)"
      },
      "properties": [
       {
        "id": "custom.axisPlacement",
        "value": "right"
       },
       {
        "id": "unit",
        "value": "none"
       },
       {
        "id": "custom.thresholdsStyle",
        "value": {
         "mode": "off"
        }
       },
       {
        "id": "custom.lineStyle",
        "value": {
         "fill": "dash",
         "dash": [
          6,
          4
         ]
        }
       }
      ]
     }
    ]
   }
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Input brightness: live window vs training data",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_window_brightness_mean",
     "legendFormat": "live (window mean)"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "roomsense_reference_brightness_mean",
     "legendFormat": "training mean"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     },
     "min": 0,
     "max": 255
    },
    "overrides": []
   }
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Predictions per minute by class",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (label) (rate(roomsense_predictions_total[5m])) * 60",
     "legendFormat": "{{label}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 40,
      "lineWidth": 1
     }
    },
    "overrides": []
   }
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Confidence: live vs validation",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_window_confidence_mean",
     "legendFormat": "live mean confidence"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "roomsense_reference_confidence_mean",
     "legendFormat": "validation mean confidence"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "roomsense_window_low_confidence_ratio",
     "legendFormat": "share below 0.6"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Inference latency",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(roomsense_inference_latency_seconds_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(roomsense_inference_latency_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     },
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Live accuracy vs capture labels",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_live_accuracy >= 0",
     "legendFormat": "accuracy (window)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     },
     "min": 0,
     "max": 1
    },
    "overrides": []
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Model lifecycle",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_model_version",
     "legendFormat": "serving version"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "roomsense_retrain_pending",
     "legendFormat": "retrain pending"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "increase(roomsense_retrain_requests_total[1h])",
     "legendFormat": "retrain requests (1h)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     },
     "min": 0,
     "decimals": 0
    },
    "overrides": []
   }
  },
  {
   "id": 13,
   "type": "timeseries",
   "title": "Camera health",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 28,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "time() - roomsense_last_frame_timestamp_seconds",
     "legendFormat": "seconds since last frame"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "increase(roomsense_camera_errors_total[10m])",
     "legendFormat": "fetch errors (10m)"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     },
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Brightness distribution of live frames (share per bin)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 28,
    "w": 12,
    "h": 6
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (le) (increase(roomsense_input_brightness_bucket[10m]))",
     "legendFormat": "{{le}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 10
     },
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 15,
   "type": "row",
   "title": "Training pipeline (latest run, from MLflow)",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 34,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 16,
   "type": "stat",
   "title": "Latest pipeline run",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 35,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_pipeline_last_run_success",
     "legendFormat": "",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "Failed",
         "color": "red"
        },
        "1": {
         "text": "Succeeded",
         "color": "green"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 17,
   "type": "stat",
   "title": "Pipeline runs recorded",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 5,
    "y": 35,
    "w": 5,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "roomsense_pipeline_runs",
     "legendFormat": "{{result}}",
     "instant": true,
     "range": false
    }
   ],
   "fieldConfig": {
    "defaults": {
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "colorMode": "value",
    "graphMode": "none",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "textMode": "value_and_name"
   }
  },
  {
   "id": 18,
   "type": "stat",
   "title": "Whole pipeline took",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 10,
    "y": 35,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
