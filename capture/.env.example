# Capture service settings. Copy to capture/.env (git-ignored) and fill in.
CAM_URL=http://192.168.0.104:8080/shot.jpg   # IP Webcam's still-image URL on the room Wi-Fi
CAM_USER=
CAM_PASS=
INTERVAL_SECONDS=5                           # one frame every 5 s while a session records
TIMEZONE=Asia/Kolkata
